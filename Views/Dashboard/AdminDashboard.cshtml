@model Assignment1_2139.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4">Welcome to Admin Dashboard</h2>

<div class="row">

    <!-- Total Revenue -->
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h4>Total Revenue</h4>
                <h2>@Model.TotalRevenue.ToString("C")</h2>
            </div>
        </div>
    </div>

    <!-- Number of Events -->
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h4>Total Events</h4>
                <h2>@Model.MyEvents.Count()</h2>
            </div>
        </div>
    </div>

</div>

<hr />

<!-- Charts -->
<h3>Analytics</h3>

<div class="row">
    <div class="col-md-6">
        <h5>Tickets Sold by Category</h5>
        <canvas id="categoryChart"></canvas>
    </div>

    <div class="col-md-6">
        <h5>Revenue Per Month</h5>
        <canvas id="revenueChart"></canvas>
    </div>
</div>

<hr />

<!-- Top Events -->
<h3 class="mt-4">Top 5 Best-Selling Events</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Event</th>
            <th>Tickets Sold</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in (IEnumerable<dynamic>)Model.Top5Events)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Sold</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // ----- CATEGORY CHART -----
        const categoryLabels = [
            @foreach (var item in (IEnumerable<dynamic>)Model.TicketSalesByCategory)
            {
                @: "@item.Category",
            }
        ];

        const categoryData = [
            @foreach (var item in (IEnumerable<dynamic>)Model.TicketSalesByCategory)
            {
                @: @item.TicketsSold,
            }
        ];

        new Chart(document.getElementById("categoryChart"), {
            type: 'pie',
            data: {
                labels: categoryLabels,
                datasets: [{
                    label: "Tickets Sold",
                    data: categoryData,
                    backgroundColor: ["#ff6384", "#36a2eb", "#ffce56", "#4bc0c0"]
                }]
            }
        });


        // ----- REVENUE CHART -----
        const revenueLabels = [
            @foreach (var item in (IEnumerable<dynamic>)Model.RevenuePerMonth)
            {
                @: "@item.Year-@item.Month.ToString("D2")",
            }
        ];

        const revenueData = [
            @foreach (var item in (IEnumerable<dynamic>)Model.RevenuePerMonth)
            {
                @: @item.Revenue,
            }
        ];

        new Chart(document.getElementById("revenueChart"), {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: "Revenue",
                    data: revenueData,
                    borderColor: "#36a2eb",
                    backgroundColor: "rgba(54,162,235,0.2)",
                    borderWidth: 2
                }]
            }
        });
    </script>
}

