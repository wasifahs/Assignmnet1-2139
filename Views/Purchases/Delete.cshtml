@model Assignment1_2139.Models.Purchase

<h2>Delete Purchase</h2>

<div class="alert alert-danger">
    <p>Are you sure you want to delete this purchase?</p>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Guest Name:</strong> @Model.GuestName</p>
        <p><strong>Guest Email:</strong> @Model.GuestEmail</p>
        <p><strong>Purchase Date:</strong> @(Model.PurchaseDate.ToLocalTime().ToString("f"))</p>
        <p><strong>Total Cost:</strong> @Model.TotalCost.ToString("C")</p>

        @if (Model.EventPurchases != null && Model.EventPurchases.Any())
        {
            <h5>Purchased Events:</h5>
            <ul>
                @foreach (var ep in Model.EventPurchases)
                {
                    <li>
                        <strong>Event:</strong> @ep.Event?.Title
                        &nbsp;|&nbsp;
                        <strong>Tickets:</strong> @ep.TicketQuantity
                    </li>
                }
            </ul>
        }
    </div>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PurchaseId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
