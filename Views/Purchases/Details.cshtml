@model Assignment1_2139.Models.Purchase

<h2>Purchase Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <!-- Guest Info -->
        <p><strong>Guest Name:</strong> @Model.GuestName</p>
        <p><strong>Guest Email:</strong> @Model.GuestEmail</p>
        <p><strong>Purchase Date:</strong> @Model.PurchaseDate.ToString("f")</p>
        <p><strong>Total Cost:</strong> @Model.TotalCost.ToString("C")</p>

        <!-- Audit Info -->
        <p><strong>Created At:</strong> @Model.CreatedAt.ToString("g")</p>
        <p><strong>Created By:</strong> @(Model.CreatedBy ?? "System")</p>
        <p><strong>Modified At:</strong> @(Model.ModifiedAt?.ToString("g") ?? "N/A")</p>
        <p><strong>Modified By:</strong> @(Model.ModifiedBy ?? "System")</p>

        <!-- Purchased Events List -->
        @if (Model.EventPurchases != null && Model.EventPurchases.Any())
        {
            <h5 class="mt-3">Purchased Events:</h5>
            <ul class="list-group">
                @foreach (var ep in Model.EventPurchases)
                {
                    var ticketPrice = ep.Event?.TicketPrice ?? 0;
                    var subtotal = ticketPrice * ep.TicketQuantity;

                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Event:</strong> @ep.Event?.Title ?? "N/A"
                            &nbsp;|&nbsp;
                            <strong>Tickets:</strong> @ep.TicketQuantity
                            &nbsp;|&nbsp;
                            <strong>Price per Ticket:</strong> @ticketPrice.ToString("C")
                            &nbsp;|&nbsp;
                            <strong>Subtotal:</strong> @subtotal.ToString("C")
                        </div>
                        <div>
                            <!-- QR Code -->
                            <img src="@Url.Action("GenerateQRCode", "Purchases", new { purchaseId = Model.PurchaseId, eventId = ep.EventId })" 
                                 alt="QR Code" style="height:60px;width:60px;" />

                            <!-- Rating for past events -->
                            @if (ep.Event != null && ep.Event.StartDate < DateTime.UtcNow)
                            {
                                <span class="ms-2">
                                    <label>Rate:</label>
                                    <select class="form-select form-select-sm d-inline w-auto" 
                                            onchange="submitRating(@ep.EventId, this.value)">
                                        <option value="">--</option>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    </select>
                                </span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No purchased events.</p>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-2">Back to List</a>

@section Scripts {
    <script>
        function submitRating(eventId, value) {
            if (!value) return;

            fetch('/Purchases/RateEvent', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() 
                },
                body: JSON.stringify({ eventId: eventId, rating: parseInt(value) })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) alert('Rating submitted successfully!');
                else alert('Failed to submit rating.');
            });
        }
    </script>
}














