@model Assignment1_2139.Models.Purchase
@using Microsoft.AspNetCore.Mvc.Rendering

<h2>Edit Purchase</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="PurchaseId" />

    <div class="mb-3">
        <label asp-for="GuestName" class="form-label"></label>
        <input asp-for="GuestName" class="form-control" />
        <span asp-validation-for="GuestName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GuestEmail" class="form-label"></label>
        <input asp-for="GuestEmail" type="email" class="form-control" />
        <span asp-validation-for="GuestEmail" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TotalCost" class="form-label"></label>
        <input asp-for="TotalCost" class="form-control" />
        <span asp-validation-for="TotalCost" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Event</label>
        <select name="EventId" class="form-select" required>
            <option value="">-- Select Event --</option>
            @foreach (var e in ViewBag.EventList as List<SelectListItem>)
            {
                var isSelected = Model.EventPurchases?.FirstOrDefault()?.EventId.ToString() == e.Value;
                <option value="@e.Value" selected="@(isSelected ? "selected" : null)">@e.Text</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Ticket Quantity</label>
        <input type="number" name="TicketQuantity" min="1" 
               value="@(Model.EventPurchases?.FirstOrDefault()?.TicketQuantity ?? 1)" 
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
