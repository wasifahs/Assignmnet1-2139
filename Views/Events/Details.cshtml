@model Assignment1_2139.Models.Event

<h2>Event Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Title:</strong> @Model.Title</p>
        <p><strong>Category:</strong> @Model.Category?.Name</p>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Start Date:</strong> @Model.StartDate.ToString("yyyy-MM-dd HH:mm")</p>
        <p><strong>End Date:</strong> @Model.EndDate.ToString("yyyy-MM-dd HH:mm")</p>
        <p><strong>Ticket Price:</strong> @Model.TicketPrice.ToString("C")</p>
        <p><strong>Available Tickets:</strong> @Model.AvailableTickets</p>
        <p><strong>Status:</strong> @Model.EventStatus.ToString()</p>
    </div>
</div>
@if (User.IsInRole("Attendee"))
{
    <a asp-controller="Events" asp-action="Buy" asp-route-id="@Model.Id" class="btn btn-primary">Buy Tickets</a>
    
}

<a asp-action="Index" class="btn btn-secondary">Back to List</a>





   


