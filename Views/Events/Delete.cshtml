@model Assignment1_2139.Models.Event

<h2>Delete Event</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this event?
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">Id</dt>
            <dd class="col-sm-10">@Model.Id</dd>

            <dt class="col-sm-2">Event Title</dt>
            <dd class="col-sm-10">@Model.Title</dd>

            <dt class="col-sm-2">CategoryId</dt>
            <dd class="col-sm-10">@Model.CategoryId</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Description</dd>

            <dt class="col-sm-2">Start Date</dt>
            <dd class="col-sm-10">@Model.StartDate.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-2">End Date</dt>
            <dd class="col-sm-10">@Model.EndDate.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-2">Ticket Price</dt>
            <dd class="col-sm-10">@Model.TicketPrice.ToString("C")</dd>

            <dt class="col-sm-2">Available Tickets</dt>
            <dd class="col-sm-10">@Model.AvailableTickets</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>