@model Assignment1_2139.Models.EventPurchase

<h2>Edit Event Purchase</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="EventId" />
    <input type="hidden" asp-for="PurchaseId" />

    <div class="mb-3">
        <label asp-for="EventId" class="form-label"></label>
        <select asp-for="EventId" class="form-select" asp-items="ViewBag.Events">
            <option value="">-- Select Event --</option>
        </select>
        <span asp-validation-for="EventId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PurchaseId" class="form-label"></label>
        <select asp-for="PurchaseId" class="form-select" asp-items="ViewBag.Purchases">
            <option value="">-- Select Purchase --</option>
        </select>
        <span asp-validation-for="PurchaseId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TicketQuantity" class="form-label"></label>
        <input asp-for="TicketQuantity" class="form-control" />
        <span asp-validation-for="TicketQuantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}